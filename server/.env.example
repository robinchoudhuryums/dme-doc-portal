# Server
NODE_ENV=development
PORT=3001

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dme_esign
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# JWT
JWT_SECRET=change-this-to-a-secure-random-string
JWT_STAFF_EXPIRES=8h
JWT_PHYSICIAN_EXPIRES=1h

# AWS S3 (must be HIPAA-eligible with BAA)
S3_BUCKET=dme-esign-documents
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Signing Links
SIGNING_BASE_URL=http://localhost:5173
SIGNING_LINK_EXPIRY_DAYS=30
MAX_PIN_ATTEMPTS=5
PIN_LENGTH=6

# Fax Provider (twilio or srfax)
FAX_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FAX_NUMBER=

# SMTP Email
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@universalmedicalsupply.com

# Webhook
WEBHOOK_SIGNED_URL=

# Reminders
REMINDER_CRON=0 9 * * *

# HIPAA
SESSION_TIMEOUT_MINUTES=15
CORS_ORIGIN=http://localhost:5173
